# ============================================================
# PROYECTO EDA F1 — .gitignore
# ============================================================

# --- Datos crudos y procesados (no subir al repo) ---
src/data/raw/
src/data/*.csv
*.csv
*.zip
*.parquet
*.feather
*.pkl
*.pickle

# --- Python y caché ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# --- Entornos virtuales y variables locales ---
.venv/
venv/
env/
.env

# --- Jupyter Notebook ---
.ipynb_checkpoints/

# --- Editor y Sistema Operativo ---
.vscode/
tempCodeRunnerFile.py
.DS_Store
Thumbs.db
